# Ficheros generados por Vite (código, estilos y fuentes): llevan una huella en
# el nombre que cambia en cada versión, así que el navegador puede guardarlos un
# año sin volver a preguntar. Este fichero acaba en dist/assets/ junto a ellos y
# prevalece sobre la regla de un día del .htaccess raíz.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
