# Ficheros generados por Vite (código, estilos y fuentes): llevan una huella en
# el nombre que cambia en cada versión, así que el navegador puede guardarlos un
# año sin volver a preguntar. Este fichero acaba en dist/assets/ junto a ellos.
#
# Va dentro de <FilesMatch>, como la regla de un día del .htaccess raíz: Apache
# aplica los <FilesMatch> después de las reglas de carpeta y, entre ellos, los de
# las carpetas más interiores al final. Sin <FilesMatch>, ganaría la del raíz.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
